    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import re\n",
        "from sklearn.model_selection import train_test_split, GridSearchCV\n",
        "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.calibration import CalibratedClassifierCV\n",
        "from sklearn.metrics import classification_report, accuracy_score, confusion_matrix\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "\n",
        "try:\n",
        "    df = pd.read_csv('data_science_job_posts_2025.csv')\n",
        "except FileNotFoundError:\n",
        "    raise FileNotFoundError(\"Файл 'data_science_job_posts_2025.csv' не найден.\")\n",
        "\n",
        "print(f\"Данные загружены: {len(df)} записей, {len(df.columns)} столбцов.\")\n",
        "\n",
        "# 2. Обзор данных\n",
        "print(\"\\nПервые 5 строк:\")\n",
        "print(df.head())\n",
        "print(\"\\nОсновные статистики:\")\n",
        "print(df.describe(include='all'))\n",
        "\n",
        "# 3. Проверка пропущенных значений\n",
        "print(\"\\nПропущенные значения:\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# 4. Очистка и предобработка\n",
        "df.fillna('Unknown', inplace=True)\n",
        "\n",
        "# Извлечение зарплаты (надёжная очистка)\n",
        "if 'salary' in df.columns:\n",
        "    def extract_salary(salary_str):\n",
        "        salary_str = str(salary_str).strip()\n",
        "        cleaned = re.sub(r'[^\\d.,]', '', salary_str)\n",
        "        if not cleaned:\n",
        "            return 0.0\n",
        "        if ',' in cleaned and '.' in cleaned:\n",
        "            cleaned = cleaned.replace(',', '')\n",
        "        elif ',' in cleaned:\n",
        "            cleaned = cleaned.replace(',', '.')\n",
        "        cleaned = re.sub(r'[^0-9.]', '', cleaned)\n",
        "        if not cleaned or cleaned == '.':\n",
        "            return 0.0\n",
        "        try:\n",
        "            return float(cleaned)\n",
        "        except ValueError:\n",
        "            return 0.0\n",
        "    df['salary_numeric'] = df['salary'].apply(extract_salary)\n",
        "else:\n",
        "    df['salary_numeric'] = 0.0\n",
        "\n",
        "# Обработка даты публикации\n",
        "if 'post_date' in df.columns:\n",
        "    def parse_days_ago(date_str):\n",
        "        date_str = str(date_str).strip().lower()\n",
        "        if not date_str or not any(c.isdigit() for c in date_str):\n",
        "            return 0\n",
        "        match = re.search(r'^\\d+', date_str)\n",
        "        if not match:\n",
        "            return 0\n",
        "        num = int(match.group())\n",
        "        if 'day' in date_str:\n",
        "            return num\n",
        "        elif 'week' in date_str:\n",
        "            return num * 7\n",
        "        elif 'month' in date_str:\n",
        "            return num * 30\n",
        "        else:\n",
        "            return num\n",
        "    df['days_since_posted'] = df['post_date'].apply(parse_days_ago)\n",
        "else:\n",
        "    print(\"Столбец 'post_date' не найден. Добавляем 'days_since_posted' = 0.\")\n",
        "    df['days_since_posted'] = 0\n",
        "\n",
        "# 5. Формирование признаков и целевой переменной\n",
        "y = df['job_title']\n",
        "\n",
        "feature_columns = [\n",
        "    'seniority_level', 'status', 'company', 'location',\n",
        "    'headquarter', 'industry', 'ownership', 'company_size',\n",
        "    'revenue', 'days_since_posted', 'salary_numeric'\n",
        "]\n",
        "available_features = [col for col in feature_columns if col in df.columns]\n",
        "X = df[available_features]\n",
        "\n",
        "print(f\"\\nИспользуемые признаки: {available_features}\")\n",
        "\n",
        "\n",
        "# 6. Кодирование и масштабирование\n",
        "categorical_cols = [\n",
        "    col for col in ['seniority_level', 'status', 'company', 'location',\n",
        "                   'headquarter', 'industry', 'ownership', 'company_size', 'revenue']\n",
        "    if col in available_features\n",
        "]\n",
        "numeric_cols = [\n",
        "    col for col in ['days_since_posted', 'salary_numeric']\n",
        "    if col in available_features\n",
        "]\n",
        "\n",
        "preprocessor = ColumnTransformer(\n",
        "    transformers=[\n",
        "        ('cat', OneHotEncoder(drop='first', handle_unknown='ignore'), categorical_cols),\n",
        "        ('num', StandardScaler(), numeric_cols)\n",
        "    ],\n",
        "    remainder='drop'\n",
        ")\n",
        "\n",
        "# 7. Фильтрация редких классов (минимум 5 примеров на класс)\n",
        "min_samples_per_class = 5\n",
        "class_counts = y.value_counts()\n",
        "valid_classes = class_counts[class_counts >= min_samples_per_class].index\n",
        "\n",
        "\n",
        "X_filtered = X[y.isin(valid_classes)]\n",
        "y_filtered = y[y.isin(valid_classes)]\n",
        "\n",
        "print(f\"\\nКлассов до фильтрации: {len(class_counts)}\")\n",
        "print(f\"Классов после фильтрации (≥{min_samples_per_class} примеров): {len(valid_classes)}\")\n",
        "print(f\"Удалено записей: {len(y) - len(y_filtered)}\")\n",
        "\n",
        "if len(valid_classes) == 0:\n",
        "    raise ValueError(\"Нет классов с достаточным числом примеров. Проверьте данные.\")\n",
        "\n",
        "\n",
        "# 8. Разделение данных\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X_filtered, y_filtered,\n",
        "    test_size=0.2,\n",
        "    random_state=42,\n",
        "    stratify=y_filtered\n",
        ")\n",
        "\n",
        "# 9. Препроцессинг и трансформация\n",
        "X_train_processed = preprocessor.fit_transform(X_train)\n",
        "X_test_processed = preprocessor.transform(X_test)\n",
        "\n",
        "print(f\"\\nРазмер обучающей выборки: {X_train_processed.shape}\")\n",
        "print(f\"Размер тестовой выборки: {X_test_processed.shape}\")\n",
        "\n",
        "# 10. Подбор гиперпараметров и обучение модели\n",
        "rf = RandomForestClassifier(random_state=42)\n",
        "\n",
        "param_grid = {\n",
        "    'n_estimators': [100, 200],\n",
        "    'max_depth': [10, 15, None],\n",
        "    'min_samples_split': [2, 5],\n",
        "    'min_samples_leaf': [1, 2]\n",
        "}\n",
        "\n",
        "grid_search = GridSearchCV(rf, param_grid, cv=3, scoring='f1_macro', n_jobs=-1)\n",
        "grid_search.fit(X_train_processed, y_train)\n",
        "\n",
        "print(f\"\\nЛучшие параметры: {grid_search.best_params_}\")\n",
        "\n",
        "# Калиброванная модель (для вероятностей)\n",
        "calibrated_model = CalibratedClassifierCV(grid_search.best_estimator_, cv=3)\n",
        "calibrated_model.fit(X_train_processed, y_train)\n",
